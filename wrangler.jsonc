{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-news",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "news.raphael-catarino.fr",
      "custom_domain": true
    }
  ]
}
