---
import { formatLong } from '../lib/dates';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'news'>;
  /** Affiche les points du TL;DR sur la carte (résumé de tête de liste). */
  showTlDr?: boolean;
}

const { entry, showTlDr = false } = Astro.props;
const { date, title, tags, tlDr } = entry.data;

const heading = title ?? `Briefing du ${formatLong(date)}`;
const preview = showTlDr ? tlDr.slice(0, 3) : [];
---

<article
  class="group relative rounded-xl border border-slate-200 bg-white/70 p-4 transition-colors hover:border-accent-200 hover:bg-white dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-slate-700 dark:hover:bg-slate-900"
>
  <h2 class="mt-1 text-lg font-semibold tracking-tight">
    <a
      href={`/briefing/${date}/`}
      class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent-600 dark:group-hover:text-accent-400"
    >
      {heading}
    </a>
  </h2>

  {
    preview.length > 0 && (
      <ul class="mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-400">
        {preview.map((point) => (
          <li class="line-clamp-2">{point}</li>
        ))}
      </ul>
    )
  }

  {
    tags.length > 0 && (
      <ul class="relative z-10 mt-2 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li>
            <a
              href={`/tags/${tag}/`}
              class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 transition-colors hover:bg-accent-100 hover:text-accent-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-accent-400"
            >
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
