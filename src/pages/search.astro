---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Recherche" description="Rechercher dans tous les briefings quotidiens.">
  <h1 class="text-3xl font-bold tracking-tight">Recherche</h1>
  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
    Index plein texte local (Pagefind), construit à chaque déploiement. Aucune requête vers un
    service tiers.
  </p>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <div id="search" class="mt-8" data-pagefind-ignore></div>

  <noscript>
    <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
      La recherche nécessite JavaScript. Vous pouvez aussi parcourir
      <a class="underline" href="/tags/">les étiquettes</a> ou
      <a class="underline" href="/rss.xml">le flux RSS</a>.
    </p>
  </noscript>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const PagefindUI = (
        window as unknown as {
          PagefindUI?: new (options: Record<string, unknown>) => unknown;
        }
      ).PagefindUI;

      // En dev, `dist/pagefind` n'existe pas encore : on l'annonce proprement.
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search')!.innerHTML =
          '<p class="text-sm text-slate-500 dark:text-slate-400">Index indisponible hors build de production (lancer <code>astro build</code>).</p>';
        return;
      }

      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: 'Rechercher un sujet, une source, une CVE…',
          clear_search: 'Effacer',
          load_more: 'Charger plus de résultats',
          search_label: 'Rechercher dans ce site',
          filters_label: 'Filtres',
          zero_results: 'Aucun résultat pour [SEARCH_TERM]',
          many_results: '[COUNT] résultats pour [SEARCH_TERM]',
          one_result: '1 résultat pour [SEARCH_TERM]',
          alt_search: 'Aucun résultat pour [SEARCH_TERM]. Résultats pour [DIFFERENT_TERM] à la place',
          search_suggestion: 'Aucun résultat pour [SEARCH_TERM]. Essayez l’une de ces recherches :',
          searching: 'Recherche de [SEARCH_TERM]…',
        },
      });
    });
  </script>
</Layout>
