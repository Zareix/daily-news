---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable" description="Cette page n'existe pas.">
  <div class="py-16 text-center">
    <p class="text-6xl font-bold tracking-tight text-accent-500">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight">Cette page n'existe pas</h1>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      Le briefing que vous cherchez n'a peut-être pas été publié ce jour-là.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm">
      <a
        href="/"
        class="rounded-lg bg-accent-600 px-4 py-2 font-medium text-white transition-colors hover:bg-accent-700"
        >Voir les briefings</a
      >
      <a
        href="/search/"
        class="rounded-lg border border-slate-200 px-4 py-2 font-medium transition-colors hover:bg-slate-100 dark:border-slate-800 dark:hover:bg-slate-900"
        >Rechercher</a
      >
    </div>
  </div>
</Layout>
