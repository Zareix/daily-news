---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { byDateDesc, formatLong, readingTime } from '../../lib/dates';

export async function getStaticPaths() {
  const entries = await getCollection('news');

  return entries.map((entry) => ({
    params: { date: entry.data.date },
    props: { entry },
  }));
}

// Props typées explicitement : annoter `getStaticPaths` avec `GetStaticPaths`
// élargit les props à `unknown`.
const { entry } = Astro.props as { entry: CollectionEntry<'news'> };
const { Content, headings } = await render(entry);
const { date, title, tags, tlDr } = entry.data;

const all = (await getCollection('news')).sort((a, b) => byDateDesc(a.data.date, b.data.date));
const index = all.findIndex((candidate) => candidate.data.date === date);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

// Les H2 du briefing sont les catégories : on en fait un sommaire.
const sections = headings.filter((heading) => heading.depth === 2);

const heading = title ?? `Briefing du ${formatLong(date)}`;
const minutes = readingTime(entry.body ?? '');
---

<Layout title={heading} description={tlDr[0] ?? `Briefing du ${formatLong(date)}`}>
  <ReadingProgress />
  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{heading}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate-500 dark:text-slate-400">{minutes} min de lecture</span>
      {
        tags.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${tag}/`}
                  class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600 transition-colors hover:bg-accent-100 hover:text-accent-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-accent-400"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

  </header>

  {
    tlDr.length > 0 && (
      <aside class="mb-10 rounded-xl border border-accent-200 bg-accent-50/40 p-5 dark:border-slate-800 dark:bg-slate-900/60">
        <h2 class="text-sm font-semibold tracking-wide text-accent-700 uppercase dark:text-accent-400">
          En bref
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {tlDr.map((point) => (
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="text-accent-500">▸</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  {
    sections.length > 1 && (
      <details
        class="mb-10 rounded-xl border border-slate-200 p-4 text-sm dark:border-slate-800"
        open
      >
        <summary class="cursor-pointer font-medium text-slate-700 dark:text-slate-300">
          Sommaire
        </summary>
        <ul class="mt-3 space-y-2">
          {sections.map((section) => (
            <li>
              <a
                href={`#${section.slug}`}
                class="text-slate-600 hover:text-accent-600 dark:text-slate-300 dark:hover:text-accent-400"
              >
                {section.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  <div class="briefing prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </div>

  <nav
    class="mt-14 grid gap-4 border-t border-slate-200 pt-6 sm:grid-cols-2 dark:border-slate-800"
    aria-label="Navigation entre briefings"
  >
    <div>
      {
        older && (
          <a href={`/briefing/${older.data.date}/`} class="group block">
            <span class="text-xs text-slate-500 dark:text-slate-400">← Précédent</span>
            <span class="mt-0.5 block font-medium group-hover:text-accent-600 dark:group-hover:text-accent-400">
              {formatLong(older.data.date)}
            </span>
          </a>
        )
      }
    </div>
    <div class="sm:text-right">
      {
        newer && (
          <a href={`/briefing/${newer.data.date}/`} class="group block">
            <span class="text-xs text-slate-500 dark:text-slate-400">Suivant →</span>
            <span class="mt-0.5 block font-medium group-hover:text-accent-600 dark:group-hover:text-accent-400">
              {formatLong(newer.data.date)}
            </span>
          </a>
        )
      }
    </div>
  </nav>
</Layout>
