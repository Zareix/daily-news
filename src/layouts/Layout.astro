---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { formatShort } from '../lib/dates';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daily News',
  description = 'Briefing quotidien : France, code & informatique, cybersécurité, international. Généré chaque matin, chaque info sourcée.',
} = Astro.props;

const site = Astro.site ?? new URL('https://news.raphael-catarino.fr');
const canonical = new URL(Astro.url.pathname, site);
const fullTitle = title === 'Daily News' ? 'Daily News — briefing quotidien' : `${title} · Daily News`;

// La page d'accueil (« Briefings ») n'est pas répétée ici : le logo y mène déjà.
// « À propos » et le sélecteur de thème vivent dans le pied de page.
// La recherche vit dans la modale Pagefind (icône loupe plus bas dans la nav).
const nav: { href: string; label: string }[] = [{ href: '/tags/', label: 'Tags' }];

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Polices auto-hébergées via la Fonts API : les fichiers sont servis depuis /_astro/fonts/.
        Inter et Newsreader sont préchargées (visibles au-dessus de la ligne de flottaison), pas la mono. */}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daily News"
      href={new URL('/rss.xml', site)}
    />

    {/* Recherche : modale Pagefind (Component UI). L'index n'existe qu'après un build
        (`pagefind --site dist`) ; en dev les deux fichiers 404 et la modale est simplement absente. */}
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daily News" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:rounded-md focus:bg-accent-600 focus:px-3 focus:py-2 focus:text-white"
      >Aller au contenu</a
    >

    <header
      class="sticky top-0 z-20 border-b border-slate-200/70 bg-stone-50/70 backdrop-blur-md dark:border-slate-800/70 dark:bg-slate-950/70"
    >
      <div class="mx-auto flex max-w-4xl items-center gap-2 px-4 py-3 sm:gap-4 sm:px-6">
        <a href="/" class="group flex shrink-0 items-baseline gap-2">
          <span class="font-serif text-base font-semibold tracking-tight">Daily&nbsp;News</span>
          <span
            class="hidden text-xs text-slate-500 transition-colors group-hover:text-accent-600 sm:inline dark:text-slate-400"
            >par Raphaël</span
          >
        </a>

        <nav class="ml-auto flex shrink-0 items-center gap-0.5 text-sm sm:gap-1" aria-label="Navigation principale">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-2 py-1.5 whitespace-nowrap transition-colors sm:px-2.5',
                  isActive(item.href)
                    ? 'bg-accent-50 font-medium text-accent-700 dark:bg-slate-900 dark:text-accent-400'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-stone-100',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <pagefind-modal-trigger compact placeholder="Recherche"></pagefind-modal-trigger>
        </nav>

      </div>
    </header>

    <main id="contenu" data-pagefind-body class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 dark:border-slate-800">
      <div
        class="mx-auto flex max-w-4xl flex-col gap-3 px-4 py-8 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:text-slate-400"
      >
        <p>Écrit par le cron Hermes, chaque matin.</p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <a class="underline decoration-dotted hover:text-accent-600" href="/about/">À propos</a>
          <span aria-hidden="true">·</span>
          <a class="underline decoration-dotted hover:text-accent-600" href="/rss.xml">RSS</a>
          <span aria-hidden="true">·</span>
          <span>{formatShort(new Date().toISOString().slice(0, 10))}</span>
        </div>
      </div>
    </footer>

    <button
      id="retour-haut"
      type="button"
      aria-label="Revenir en haut de la page"
      title="Revenir en haut de la page"
      class="fixed right-4 bottom-4 z-30 flex size-10 cursor-pointer items-center justify-center rounded-full border border-slate-200/70 bg-stone-50/80 text-slate-600 shadow-md backdrop-blur-md transition-colors hover:text-accent-600 dark:border-slate-800/70 dark:bg-slate-950/80 dark:text-slate-400 dark:hover:text-accent-400 sm:right-6 sm:bottom-6"
    >
      <svg
        class="block size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <pagefind-modal></pagefind-modal>

    <script>
      // Les liens sortants s'ouvrent dans un nouvel onglet.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
        if (link.hostname !== location.hostname) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
      }

      const retourHaut = document.querySelector<HTMLButtonElement>('#retour-haut');
      if (retourHaut) {
        const bascule = () => retourHaut.toggleAttribute('data-visible', window.scrollY >= 600);
        bascule();
        window.addEventListener('scroll', bascule, { passive: true });
        retourHaut.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
