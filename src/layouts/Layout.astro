---
import '../styles/global.css';
import { formatShort } from '../lib/dates';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daily News',
  description = 'Briefing quotidien : France, code & informatique, cybersécurité, international. Généré chaque matin, chaque info sourcée.',
} = Astro.props;

const site = Astro.site ?? new URL('https://news.raphael-catarino.fr');
const canonical = new URL(Astro.url.pathname, site);
const fullTitle = title === 'Daily News' ? 'Daily News — briefing quotidien' : `${title} · Daily News`;

// La page d'accueil (« Briefings ») n'est pas répétée ici : le logo y mène déjà.
// « À propos » et le sélecteur de thème vivent dans le pied de page.
// `icon` remplace le libellé visible ; `label` reste le nom accessible (aria-label + title).
const nav: { href: string; label: string; icon?: 'search' }[] = [
  { href: '/tags/', label: 'Étiquettes' },
  { href: '/search/', label: 'Recherche', icon: 'search' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daily News"
      href={new URL('/rss.xml', site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daily News" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Anti-FOUC : la classe `.dark` est posée avant le premier paint.
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* localStorage indisponible : on reste en clair */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:rounded-md focus:bg-accent-600 focus:px-3 focus:py-2 focus:text-white"
      >Aller au contenu</a
    >

    <header
      class="sticky top-0 z-20 border-b border-slate-200/70 bg-stone-50/85 backdrop-blur-md dark:border-slate-800/70 dark:bg-slate-950/85"
    >
      <div class="mx-auto flex max-w-4xl items-center gap-2 px-4 py-3 sm:gap-4 sm:px-6">
        <a href="/" class="group flex shrink-0 items-baseline gap-2">
          <span class="text-base font-semibold tracking-tight">Daily&nbsp;News</span>
          <span
            class="hidden text-xs text-slate-500 transition-colors group-hover:text-accent-600 sm:inline dark:text-slate-400"
            >par Raphaël</span
          >
        </a>

        <nav class="ml-auto flex shrink-0 items-center gap-0.5 text-sm sm:gap-1" aria-label="Navigation principale">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                aria-label={item.icon ? item.label : undefined}
                title={item.icon ? item.label : undefined}
                class:list={[
                  'rounded-md px-2 py-1.5 whitespace-nowrap transition-colors sm:px-2.5',
                  isActive(item.href)
                    ? 'bg-accent-50 font-medium text-accent-700 dark:bg-slate-900 dark:text-accent-400'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-stone-100',
                ]}
              >
                {item.icon === 'search' ? (
                  <svg
                    class="block size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m21 21-4.34-4.34"></path>
                    <circle cx="11" cy="11" r="8"></circle>
                  </svg>
                ) : (
                  item.label
                )}
              </a>
            ))
          }
        </nav>

      </div>
    </header>

    <main id="contenu" data-pagefind-body class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 dark:border-slate-800">
      <div
        class="mx-auto flex max-w-4xl flex-col gap-3 px-4 py-8 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:text-slate-400"
      >
        <p>Écrit par le cron Hermes, chaque matin.</p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <a class="underline decoration-dotted hover:text-accent-600" href="/about/">À propos</a>
          <span aria-hidden="true">·</span>
          <a class="underline decoration-dotted hover:text-accent-600" href="/rss.xml">RSS</a>
          <span aria-hidden="true">·</span>
          <span>{formatShort(new Date().toISOString().slice(0, 10))}</span>

          <button
            id="theme-toggle"
            type="button"
            title="Thème clair / sombre"
            class="rounded-md border border-slate-200 p-1.5 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-stone-100"
            aria-label="Basculer le thème clair/sombre"
          >
            <svg
              class="size-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              class="hidden size-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </footer>

    <script>
      const STORAGE_KEY = 'theme';

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem(STORAGE_KEY, isDark ? 'dark' : 'light');
        } catch {
          /* ignore */
        }
      });

      // Les liens sortants s'ouvrent dans un nouvel onglet.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
        if (link.hostname !== location.hostname) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
      }
    </script>
  </body>
</html>
